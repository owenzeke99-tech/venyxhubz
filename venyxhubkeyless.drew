-- Configuration
local CorrectKey = "VenyxHubKeyKalwowhKalwowjwnNqkaowjjwwoi"
local GetKeyLink = "https://link4m.net/BnFcAvj"
local SaveFileName = "VenyxHub_SavedKey.txt"
local ExpirationTime = 86400 -- 24 hours in seconds

local HttpService = game:GetService("HttpService")
local TweenService = game:GetService("TweenService")

-- Function to load Venyx Hub
local function LoadMainHub()
    local success, err = pcall(function()
        loadstring(game:HttpGet("https://raw.githubusercontent.com/tienkhanh1/Venyx/main/VenyxHub"))()
    end)
    if not success then
        warn("Failed to load Venyx Hub: " .. tostring(err))
    end
end

-- Function to Save Key with Timestamp
local function SaveKey(key)
    if writefile then
        local data = {
            Key = key,
            Timestamp = os.time()
        }
        writefile(SaveFileName, HttpService:JSONEncode(data))
    end
end

-- Function to Check Saved Key
local function VerifySavedKey()
    if isfile and readfile and isfile(SaveFileName) then
        local success, result = pcall(function()
            return HttpService:JSONDecode(readfile(SaveFileName))
        end)
        
        if success and type(result) == "table" then
            local savedKey = result.Key
            local savedTime = result.Timestamp or 0
            
            -- Check if key is correct and not expired (24 hours)
            if savedKey == CorrectKey and (os.time() - savedTime) < ExpirationTime then
                return true
            end
        end
    end
    return false
end

-- Check if valid key is already saved
if VerifySavedKey() then
    LoadMainHub()
    return
end

