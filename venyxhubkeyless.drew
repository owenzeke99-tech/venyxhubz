-- Hover Effects
local function addHoverEffect(button, normalBg, hoverBg)
    button.MouseEnter:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.2), {BackgroundColor3 = hoverBg}):Play()
    end)
    button.MouseLeave:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.2), {BackgroundColor3 = normalBg}):Play()
    end)
end

addHoverEffect(GetKeyBtn, Color3.fromRGB(25, 25, 25), Color3.fromRGB(40, 40, 40))
addHoverEffect(CheckKeyBtn, Color3.fromRGB(255, 255, 255), Color3.fromRGB(215, 215, 215))

-- Smooth Shake Animation Function
local function playSmoothShake()
    local origPos = UDim2.new(0.5, 0, 0.5, 0)
    local offsets = {10, -8, 6, -4, 2, 0}
    
    task.spawn(function()
        for _, offset in ipairs(offsets) do
            local tween = TweenService:Create(MainFrame, TweenInfo.new(0.05, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
                Position = origPos + UDim2.new(0, offset, 0, 0)
            })
            tween:Play()
            tween.Completed:Wait()
        end
    end)
end

-- Status Banner Display Function
local function showStatus(text, isError)
    StatusLabel.Text = text
    if isError then
        StatusFrame.BackgroundColor3 = Color3.fromRGB(35, 18, 18)
        StatusStroke.Color = Color3.fromRGB(180, 50, 50)
        StatusLabel.TextColor3 = Color3.fromRGB(255, 90, 90)
    else
        StatusFrame.BackgroundColor3 = Color3.fromRGB(18, 35, 22)
        StatusStroke.Color = Color3.fromRGB(50, 180, 80)
        StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 120)
    end
    
    TweenService:Create(StatusFrame, TweenInfo.new(0.2), {BackgroundTransparency = 0.2}):Play()
    TweenService:Create(StatusStroke, TweenInfo.new(0.2), {Transparency = 0}):Play()
    TweenService:Create(StatusLabel, TweenInfo.new(0.2), {TextTransparency = 0}):Play()
end

-- Get Key Button Click Event
GetKeyBtn.MouseButton1Click:Connect(function()
    if setclipboard then
        setclipboard(GetKeyLink)
        showStatus("✓ Get Key link copied to clipboard!", false)
    else
        showStatus("ⓘ Get Key Link: " .. GetKeyLink, false)
    end
end)

-- Check Key Button Click Event
CheckKeyBtn.MouseButton1Click:Connect(function()
    if TextBox.Text == CorrectKey then
        showStatus("✓ Access Granted! Loading Venyx Hub...", false)
        
        -- Save key locally for 24 hours
        SaveKey(TextBox.Text)
        
        -- Success Fade Animation
        TweenService:Create(MainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
            Size = UDim2.new(0, 0, 0, 0),
            BackgroundTransparency = 1
        }):Play()
        
        task.wait(0.4)
        ScreenGui:Destroy()
        
        -- Load Venyx Hub Script
        LoadMainHub()
    else
        -- Invalid Key Handling
        showStatus("✕ Invalid Key! Please try again.", true)
        TextBox.Text = "" -- Automatically clears incorrect text
        playSmoothShake() -- Smooth shake animation
    end
end)
